<Window x:Class="DDCInteligence.View.CustomInputBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDCInteligence.View"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="SweetAlert"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        BorderBrush="Transparent"
        BorderThickness="0"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        FontFamily="Consolas"
        Topmost="False"
        WindowState="Maximized"
        Loaded="Window_Loaded"
        KeyUp="Event_KeyUp"
        Closing="Event_Closing"
        Background="#80000000">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Animation/AnimationResource.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- Semi-transparent black background covering entire screen -->
        <Rectangle Fill="#80000000" MouseDown="Background_MouseDown"/>

        <!-- Your modal content centered -->
        <Border x:Name="_Dialog"
                Background="{DynamicResource RegionBrush}"
                Width="350"
                Margin="10"
                MinWidth="300"
                MaxWidth="800"
                MaxHeight="800"
                CornerRadius="5"
                Padding="20"
                RenderTransformOrigin="0.5,0.5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="5" Opacity="0.5" BlurRadius="10"/>
            </Border.Effect>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource ShowAnimation}" />
                </EventTrigger>
            </Border.Triggers>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform />
                    <SkewTransform />
                    <RotateTransform />
                    <TranslateTransform />
                </TransformGroup>
            </Border.RenderTransform>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <TextBlock x:Name="_Title"
                           Text="Custom Text"
                           FontWeight="Bold"
                           FontSize="20pt"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="_Subtitle"
                           Text="Custom Text"
                           FontWeight="Bold"
                           FontSize="10pt"
                           Opacity="0.4"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" />
                <hc:TextBox x:Name="_Content"
                           Text="{Binding Source={StaticResource Locator}, Path=ImageViewerVM.InputValue, TargetNullValue='', FallbackValue=''}"
                           FontSize="13pt"
                           Margin="0 15"
                           Style="{DynamicResource TextBoxExtend}"
                           HorizontalContentAlignment="Center"
                           TextChanged="_Content_TextChanged"
                           HorizontalAlignment="Center"
                           KeyDown="_Content_KeyDown"
                           Width="200" />
            </StackPanel>
        </Border>
    </Grid>
</Window>