<hc:Window x:Class="DDCInteligence.View.ChangePasswordView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:local="clr-namespace:DDCInteligence.View"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           mc:Ignorable="d"
           ResizeMode="NoResize"
           Background="{DynamicResource RegionBrush}"
           Icon="/Resources/Images/apex.ico"
           WindowStartupLocation="CenterScreen"
           FocusManager.FocusedElement="{Binding ElementName=Username}"
           Title="" Height="350" Width="300">

    <StackPanel Orientation="Vertical" Background="{StaticResource RegionBrush}">
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center"
                   Margin="0 15 0 0"
                   FontSize="20"
                   Text="Change Your Password?"
                   Foreground="#0066CC"
                   FontWeight="Bold" />
                <TextBlock  Margin="0 0 0 15"
                    Text="Enter your old and new password to change"
                    FontWeight="SemiBold"
                    FontSize="10"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
            <hc:TextBox hc:InfoElement.ShowClearButton="False"
                hc:InfoElement.Placeholder=""
                hc:InfoElement.TitlePlacement="Top"
                hc:InfoElement.Title="Username"
                hc:InfoElement.Necessary="False"
                Margin="11 0"
                x:Name="Username"
                IsReadOnly="True"
                Text="{Binding Source={StaticResource Locator}, Path=Process.CurrentBiller.username}" />
            <hc:PasswordBox hc:InfoElement.Title="Old Password"
                            hc:InfoElement.Placeholder=""
                            hc:InfoElement.Necessary="True"
                            ShowEyeButton="True"
                            Focusable="True"
                            Margin="11 0"
                            Name="OldPassword"
                            PreviewKeyDown="OldPassword_PreviewKeyDown"/>
            <hc:PasswordBox hc:InfoElement.Title="New Password"
                            hc:InfoElement.Placeholder=""
                            hc:InfoElement.Necessary="True"
                            ShowEyeButton="True"
                            Margin="11 0"
                            Name="NewPassword"
                            PreviewKeyDown="NewPassword_KeyDown" />
        </hc:UniformSpacingPanel>
        <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="11 20 11 11">
            <hc:UniformSpacingPanel Spacing="5">
                <Button x:Name="Submit" Content="Ok, submit!" Style="{DynamicResource ButtonPrimary}" />
                <Button x:Name="Exit" Content="Close"
                    Background="{DynamicResource DangerBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    Foreground="White"
                    FontWeight="SemiBold" />
            </hc:UniformSpacingPanel>
        </StackPanel>
    </StackPanel>
</hc:Window>
