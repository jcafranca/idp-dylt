<hc:Window x:Class="DDCInteligence.View.RejectView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:behevior="clr-namespace:DDCInteligence.Utilities.Behaviors"
           xmlns:local="clr-namespace:DDCInteligence.View"
           mc:Ignorable="d"
           Background="{DynamicResource RegionBrush}"
           WindowStartupLocation="CenterOwner"
           ShowInTaskbar="False"
           Title="Reject Remarks" MaxHeight="420" MaxWidth="300">

    <Border Margin="10">
        <hc:UniformSpacingPanel Spacing="5" Orientation="Vertical" Grid.ColumnSpan="2">
            <hc:UniformSpacingPanel Spacing="5" Orientation="Vertical">
                <CheckBox x:Name="c1" Content="Mismatch Consignee City/State/Zipcode" />
                <CheckBox x:Name="c2" Content="Mismatch Shipping Name for UN#" />
                <CheckBox x:Name="c3" Content="PRO#  Already Billed" />
                <CheckBox x:Name="c4" Content="PRO # Already Used" />
                <CheckBox x:Name="c5" Content="DisRegard" />
            </hc:UniformSpacingPanel>

            <hc:TextBox x:Name="TextBoxOthers" VerticalContentAlignment="Top" hc:InfoElement.Title="Others" Height="121" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            <hc:UniformSpacingPanel Spacing="5" Margin="0 10" Orientation="Vertical">
                <Button x:Name="RejectSendButton" Content="Send Reject [F1]" FontWeight="SemiBold" BorderBrush="{DynamicResource DangerBrush}" Background="{DynamicResource DangerBrush}" Foreground="#fff">
                    <hc:Interaction.Behaviors>
                        <behevior:ButtonClickBehavior/>
                    </hc:Interaction.Behaviors>
                </Button>
                <Button x:Name="RejectResetButton"
                        Content="Reset [F2]"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Command="{Binding SaveAsBilledCommand}">
                    <hc:Interaction.Behaviors>
                        <behevior:ButtonClickBehavior/>
                    </hc:Interaction.Behaviors>
                </Button>
                <Button x:Name="RejectCancelButton" Content="Cancel [F3]"
                        BorderBrush="{DynamicResource WarningBrush}" 
                        Background="{DynamicResource WarningBrush}"
                        Foreground="White"
                        FontWeight="SemiBold">
                    <hc:Interaction.Behaviors>
                        <behevior:ButtonClickBehavior/>
                    </hc:Interaction.Behaviors>
                </Button>
                <TextBlock TextWrapping="Wrap" FontStyle="Italic" Foreground="{DynamicResource SecondaryTextBrush}" Text="Note : Make sure that the info above are correct." />
            </hc:UniformSpacingPanel>
        </hc:UniformSpacingPanel>
    </Border>
</hc:Window>
