<Window x:Class="DDCInteligence.View.IdleView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDCInteligence.View"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:ctrls="clr-namespace:DDCInteligence.Utilities.Controls"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="On Idle (Esc to Close)"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Closing="Window_Closing"
        ShowInTaskbar="False"
        DataContext="{Binding Source={StaticResource Locator}, Path=IdleVM}"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowState="Maximized"
        Background="#80000000">

    <Grid>
        <!-- Semi-transparent black background covering entire screen -->
        <Rectangle Fill="#80000000"/>

        <Border Background="#1c1c1c" Width="400"
                Height="210"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="5" Opacity="0.5" BlurRadius="15"/>
            </Border.Effect>

            <hc:SimplePanel>
                <StackPanel Margin="5 10 5 0"  Orientation="Vertical">
                    <TextBlock Text="Idle Break"
                               Foreground="#fff"
                               FontSize="20"
                               VerticalAlignment="center"
                               HorizontalAlignment="center"
                               FontWeight="Bold" />

                    <hc:ComboBox ItemsSource="{Binding IdleReasonsList}"
                                 SelectedIndex="{Binding SelectedIndex}"
                                 IsEnabled="{Binding ElementName=StartButton, Path=IsEnabled}"
                                 Margin="50 10 50 0"
                                 FontWeight="SemiBold"
                                 hc:InfoElement.Placeholder="Select Idle Reason"
                                 Name="IdleReasons"
                                 BorderBrush="#FF0018"
                                 hc:InfoElement.ShowClearButton="True"/>

                    <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="5" Background="#1c1c1c" CornerRadius="10">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Displays the actual time in #FF0018-->
                            <TextBlock Grid.Column="0" Opacity="0.6" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding Display1stHour, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Grid.Column="1" Opacity="0.6" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding Display2ndHour, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Grid.Column="2" Opacity="0.6" Foreground="#FF0018" FontSize="80" FontFamily="{StaticResource Digital}" >:</TextBlock>
                            <TextBlock Grid.Column="3" Opacity="0.6" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding Display1stMin, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Grid.Column="4" Opacity="0.6" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding Display2ndMin, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Grid.Column="5" Opacity="0.6" Foreground="#FF0018" FontSize="80" FontFamily="{StaticResource Digital}">:</TextBlock>
                            <TextBlock Grid.Column="6" Opacity="0.6" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding Display1stSec, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Grid.Column="7" Opacity="0.6" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding Display2ndSec, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" ></TextBlock>

                            <!-- Creates a Glow Effect -->
                            <TextBlock Grid.Column="0" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding Display1stHour, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" >
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF0018" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding Display2ndHour, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" >
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF0018" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" FontFamily="{StaticResource Digital}" Text=":">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF0018" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Grid.Column="3" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding Display1stMin, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" >
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF0018" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Grid.Column="4" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding Display2ndMin, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" >
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF0018" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Grid.Column="5" Foreground="#FF0018" FontSize="80" FontFamily="{StaticResource Digital}" Text=":">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF0018" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Grid.Column="6" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding Display1stSec, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" >
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF0018" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Grid.Column="7" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding Display2ndSec, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" >
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF0018" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                </TextBlock.Effect>
                            </TextBlock>

                            <!-- Creates the effect of turned of segments -->
                            <TextBlock Foreground="White" Grid.Column="0" Opacity="0.1" FontSize="80" Text="8" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Foreground="White" Grid.Column="1" Opacity="0.1" FontSize="80" Text="8" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Foreground="White" Grid.Column="2" Opacity="0.1" FontSize="80" FontFamily="{StaticResource Digital}" >:</TextBlock>
                            <TextBlock Foreground="White" Grid.Column="3" Opacity="0.1" FontSize="80" Text="8" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Foreground="White" Grid.Column="4" Opacity="0.1" FontSize="80" Text="8" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Foreground="White" Grid.Column="5" Opacity="0.1" FontSize="80" FontFamily="{StaticResource Digital}">:</TextBlock>
                            <TextBlock Foreground="White" Grid.Column="6" Opacity="0.1" FontSize="80" Text="8" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Foreground="White" Grid.Column="7" Opacity="0.1" FontSize="80" Text="8" FontFamily="{StaticResource Digital}" ></TextBlock>

                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                        <Button x:Name="CancelButton" 
                                Margin="5"
                                Content="Esc = Close"
                                FontWeight="SemiBold" 
                                Background="Transparent"
                                Foreground="#E0E0E0"
                                BorderThickness="0"
                                BorderBrush="Transparent"
                                Click="CancelButton_Click" 
                                Cursor="Hand"/>

                        <Button x:Name="StartButton" 
                                Margin="0 5"
                                IsEnabled="{Binding IsEnable}"
                                Command="{Binding StartCommand}"
                                Content="S = Start"
                                FontWeight="SemiBold" 
                                Background="#111827"
                                Foreground="White"
                                BorderBrush="#111827" 
                                Cursor="Hand"/>

                        <Button Content="C = Cancel"
                                Margin="5"
                                IsEnabled="{Binding ElementName=StartButton, Path=IsEnabled, Converter={StaticResource ReverseBooleanConverter}}"
                                Command="{Binding StopCommand}"
                                FontWeight="SemiBold"
                                Background="#DC2626"
                                Foreground="White"
                                BorderBrush="#DC2626" 
                                Cursor="Hand"/>

                    </StackPanel>
                </StackPanel>
            </hc:SimplePanel>
        </Border>
    </Grid>
</Window>
