<hc:Window x:Class="DDCInteligence.View.AccessorialView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:local="clr-namespace:DDCInteligence.View"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           mc:Ignorable="d"
           WindowStartupLocation="CenterScreen"
           ShowInTaskbar="False"
           Title="Accessorials" Height="200" Width="500">

    <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">

        <TextBlock x:Name="_Title"
               Text="Select Accessorials"
               FontWeight="Bold"
               FontSize="20pt"
               HorizontalAlignment="Center"
               TextWrapping="Wrap" />

        <hc:TextBox  x:Name="_Content"
                 FontSize="13pt"
                 Margin="0 15"
                 Style="{DynamicResource TextBoxExtend}"
                 HorizontalContentAlignment="Center"
                 HorizontalAlignment="Center" Width="400" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Save" Style="{StaticResource ButtonPrimary}"/>
            <Button Content="Cancel" Margin="5 0 0 0"/>
        </StackPanel>
    </StackPanel>
</hc:Window>
