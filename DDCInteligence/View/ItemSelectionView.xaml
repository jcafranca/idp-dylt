<Window
    x:Class="DDCInteligence.View.ItemSelectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:DDCInteligence.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Item Selection View"
    Width="550"
    Height="450"
    ResizeMode="NoResize"
    mc:Ignorable="d">

    <Grid Margin="10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Padding="0,0,0,10"
            BorderThickness="0,0,0,1">
            <StackPanel Margin="20,0">
                <TextBlock
                    Margin="0,10,0,5"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="Item Description Selection List" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="#6B7280"
                    Text="Choose an description to continue"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  SearchBar with dynamic placeholder and search text binding  -->
            <hc:SearchBar
                x:Name="TextBoxSearch"
                Margin="0,10"
                hc:InfoElement.Placeholder="Quick Search Shift + S"
                hc:InfoElement.ShowClearButton="True"
                CharacterCasing="Upper"
                FontWeight="Bold"
                IsRealTime="True"
                Style="{StaticResource SearchBarPlus}"
                Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
            <Grid Grid.Row="1">
                <!--  ListView bound to an ItemsSource dependency property  -->
                <ListBox
                    x:Name="itemsSuggestionAccountList"
                    HorizontalContentAlignment="Left"
                    BorderThickness="0"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <!--  Suggestions will be dynamically added here  -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="SelectedList" Focusable="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  Description  -->
                                <hc:HighlightTextBlock
                                    FontWeight="SemiBold"
                                    QueriesText="{Binding ElementName=TextBoxSearch, Path=Text}"
                                    SourceText="{Binding altcommoditydesc}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--  Fallback text if no data exists  -->
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Visibility="{Binding ElementName=itemsSuggestionAccountList, Path=Items.Count, Converter={StaticResource Integer2VisibilityConverter}}">
                    <Run
                        FontFamily="{StaticResource FontAwesome}"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Text="&#xf1c0;" />
                    <Run
                        BaselineAlignment="Center"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="No data found" />
                </TextBlock>
            </Grid>
        </Grid>
        <TextBlock
            Grid.Row="2"
            Margin="10"
            FontWeight="SemiBold"
            Foreground="{StaticResource PrimaryTextBrush}"
            Text="[Enter - Select] [ESC - Close]" />
    </Grid>
</Window>
