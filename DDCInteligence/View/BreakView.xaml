<Window x:Class="DDCInteligence.View.BreakView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDCInteligence.View"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:ctrls="clr-namespace:DDCInteligence.Utilities.Controls"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="On Break (Esc to Close)"        
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#80000000">

    <Grid>
        <!-- Semi-transparent black background covering entire screen -->
        <Rectangle Fill="#80000000"/>

        <!-- Your break view content centered -->
        <Border Background="#1c1c1c"
                Width="400"
                Height="150"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="5" Opacity="0.5" BlurRadius="15"/>
            </Border.Effect>

            <hc:SimplePanel>
                <StackPanel Margin="20 10 20 20">
                    <Border CornerRadius="10"
                        Padding="0">
                        <Border Width="Auto"
                            Height="40"
                            CornerRadius="10">
                            <TextBlock x:Name="BreakText"
                                   Text="None"
                                   Foreground="White"
                                   FontSize="20"
                                   VerticalAlignment="center"
                                   HorizontalAlignment="center"
                                   FontWeight="Bold" />
                        </Border>
                    </Border>

                    <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="#1c1c1c" CornerRadius="10">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Displays the actual time in #FF0018-->
                            <TextBlock Grid.Column="0" Opacity="0.6" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BreakView}}, Path=Display1stHour, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Grid.Column="1" Opacity="0.6" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BreakView}}, Path=Display2ndHour, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Grid.Column="2" Opacity="0.6" Foreground="#FF0018" FontSize="80" FontFamily="{StaticResource Digital}" >:</TextBlock>
                            <TextBlock Grid.Column="3" Opacity="0.6" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BreakView}}, Path=Display1stMin, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Grid.Column="4" Opacity="0.6" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BreakView}}, Path=Display2ndMin, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Grid.Column="5" Opacity="0.6" Foreground="#FF0018" FontSize="80" FontFamily="{StaticResource Digital}">:</TextBlock>
                            <TextBlock Grid.Column="6" Opacity="0.6" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BreakView}}, Path=Display1stSec, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Grid.Column="7" Opacity="0.6" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BreakView}}, Path=Display2ndSec, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" ></TextBlock>

                            <!-- Creates a Glow Effect -->
                            <TextBlock Grid.Column="0" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BreakView}}, Path=Display1stHour, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" >
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF0018" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BreakView}}, Path=Display2ndHour, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" >
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF0018" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" FontFamily="{StaticResource Digital}" Text=":">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF0018" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Grid.Column="3" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BreakView}}, Path=Display1stMin, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" >
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF0018" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Grid.Column="4" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BreakView}}, Path=Display2ndMin, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" >
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF0018" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Grid.Column="5" Foreground="#FF0018" FontSize="80" FontFamily="{StaticResource Digital}" Text=":">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF0018" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Grid.Column="6" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BreakView}}, Path=Display1stSec, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}" >
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF0018" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Grid.Column="7" Foreground="#FF0018" HorizontalAlignment="Right" FontSize="80" Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:BreakView}}, Path=Display2ndSec, FallbackValue=0, TargetNullValue=0}" FontFamily="{StaticResource Digital}">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF0018" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                </TextBlock.Effect>
                            </TextBlock>

                            <!-- Creates the effect of turned of segments -->
                            <TextBlock Foreground="White" Grid.Column="0" Opacity="0.1" FontSize="80" Text="8" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Foreground="White" Grid.Column="1" Opacity="0.1" FontSize="80" Text="8" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Foreground="White" Grid.Column="2" Opacity="0.1" FontSize="80" FontFamily="{StaticResource Digital}" >:</TextBlock>
                            <TextBlock Foreground="White" Grid.Column="3" Opacity="0.1" FontSize="80" Text="8" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Foreground="White" Grid.Column="4" Opacity="0.1" FontSize="80" Text="8" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Foreground="White" Grid.Column="5" Opacity="0.1" FontSize="80" FontFamily="{StaticResource Digital}">:</TextBlock>
                            <TextBlock Foreground="White" Grid.Column="6" Opacity="0.1" FontSize="80" Text="8" FontFamily="{StaticResource Digital}" ></TextBlock>
                            <TextBlock Foreground="White" Grid.Column="7" Opacity="0.1" FontSize="80" Text="8" FontFamily="{StaticResource Digital}" ></TextBlock>

                        </Grid>
                    </Border>
                </StackPanel>
            </hc:SimplePanel>
        </Border>
    </Grid>
</Window>