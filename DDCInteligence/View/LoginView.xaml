<hc:Window x:Class="DDCInteligence.View.LoginView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:local="clr-namespace:DDCInteligence.View"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:behevior="clr-namespace:DDCInteligence.Utilities.Behaviors"
           mc:Ignorable="d"
           DataContext="{Binding Source={StaticResource Locator}, Path=Login}"
           FocusManager.FocusedElement="{Binding ElementName=TextBoxUsername}"
           WindowStartupLocation="CenterScreen"
           Icon="/Resources/Images/apex.ico"
           NonClientAreaBackground="#19233d"
           OtherButtonHoverBackground="{DynamicResource SecondaryBorderBrush}"
           OtherButtonForeground="White"
           OtherButtonHoverForeground="White"
           NonClientAreaForeground="White"
           CloseButtonForeground="White"
           Title="Sign In" MaxHeight="350" MaxWidth="550" MinHeight="350" MinWidth="550">

    <Grid Background="{StaticResource BackgroundDrawingBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="107*" />
            <RowDefinition Height="95*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2">
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10" Margin="20 0">
                <Border CornerRadius="10">
                    <Image Source="/Resources/Images/new_ddc_logo.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel  HorizontalAlignment="Center" Margin="0 -30 0 0">
                    <TextBlock TextWrapping="Wrap" FontWeight="Bold" FontSize="22" Foreground="{StaticResource PrimaryTextBrush}">
                        <Run Text="Apex" Foreground="#268b9c"/>
                        <Run Text="Data Entry for"/>
                        <Run x:Name="lblProjectCode" Text="None" Foreground="#268b9c"/>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}">
                        <Run Text=" - using this software to convert scanned documents into editable text, streamlining the process and reducing errors."/>
                    </TextBlock>
                    <TextBlock Text="FPO Solutions"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontWeight="Bold"
                               FontSize="12"/>
                </StackPanel>
            </hc:UniformSpacingPanel>
        </Border>
        <StackPanel VerticalAlignment="Top"
            Grid.Column="2"
            Margin="20 0 30 0"
            Orientation="Vertical"
            Grid.RowSpan="2">

            <TextBlock HorizontalAlignment="Center"
                       Margin="0 25 0 0"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       FontSize="20"
                       Text="Welcome back"
                       FontWeight="Bold" />
            <TextBlock  Margin="0 0 0 15"
                Text="Enter your username and password to sign in"
                FontWeight="SemiBold"
                FontSize="10"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource SecondaryTextBrush}" />

            <hc:UniformSpacingPanel Spacing="5" Orientation="Vertical" Margin="0 0 0 10">
                <hc:TextBox x:Name="TextBoxUsername" hc:InfoElement.Placeholder="Please enter your username"
                        hc:TitleElement.Title="Username"
                        hc:InfoElement.ShowClearButton="True"
                        hc:InfoElement.Necessary="True"
                        Margin="0 0 0 0"
                        Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}">
                    <hc:Interaction.Behaviors>
                        <behevior:PreviewKeydownBehevior/>
                    </hc:Interaction.Behaviors>
                </hc:TextBox>

                <hc:PasswordBox x:Name="TextBoxPassword" hc:InfoElement.Title="Password"
                                hc:InfoElement.ShowClearButton="True"
                                hc:InfoElement.Placeholder="Please enter your password"
                                hc:InfoElement.Necessary="True"
                                ShowEyeButton="False"
                                PasswordBox.PasswordChanged="TextBoxPassword_PasswordChanged">

                    <hc:Interaction.Behaviors>
                        <behevior:PreviewKeydownBehevior/>
                    </hc:Interaction.Behaviors>
                </hc:PasswordBox>

                <ComboBox Style="{StaticResource ComboBoxExtendBaseStyle}"
                          hc:InfoElement.Title="Account"
                          ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedRole}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                 <Run Foreground="Silver" Text="{Binding Icon}" FontFamily="{StaticResource FontAwesome}"/>
                                 <Run Text="{Binding Name}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock>                    
                    <Hyperlink TextDecorations="None" Command="{Binding ResetPassword}">Reset Password</Hyperlink>
                </TextBlock>
            </hc:UniformSpacingPanel>


            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Height="30"
                            BorderThickness="0"
                            BorderBrush="{DynamicResource DangerBrush}"
                            Background="{DynamicResource DangerBrush}"
                            Foreground="White"
                            x:Name="LoginButtonCancel"
                            Margin="5 0"
                            FontWeight="SemiBold">
                        <hc:Interaction.Behaviors>
                            <behevior:ButtonClickBehavior/>
                        </hc:Interaction.Behaviors>
                    </Button>
                    <ToggleButton Grid.Column="3"
                          IsEnabled="{Binding Loading, Mode=TwoWay,FallbackValue=true, TargetNullValue=true, Converter={StaticResource ReverseBooleanConverter}}"
                          IsChecked="{Binding Loading, Mode=TwoWay,FallbackValue=false, TargetNullValue=false}"
                          Style="{StaticResource ToggleButtonLoadingPrimary}"
                          Content="Login"
                          Height="30"
                          Width="90"
                          FontWeight="SemiBold"
                          BorderThickness="0"
                          x:Name="ButtonLogin"
                          Command="{Binding LoginCommand}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</hc:Window>
