<Window x:Class="DDCInteligence.View.SearchCityView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDCInteligence.View"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:b="clr-namespace:DDCInteligence.Utilities.Behaviors"
        mc:Ignorable="d"
        ResizeMode="CanMinimize"
        Title="Search City / " 
        Height="300" 
        Width="500"
        FocusManager.FocusedElement="{Binding ElementName=TextBoxCity}">
    <Grid Margin="10 0 10 10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TextBoxCity" Grid.Column="0" Margin="5" 
                     Style="{StaticResource TextBoxExtend}" 
                     hc:InfoElement.Title="City" hc:InfoElement.TitlePlacement="Left"
                     TextChanged="TextBoxCity_TextChanged">
                <hc:Interaction.Behaviors>
                    <b:FocusBehavior/>
                    <b:PreviewKeydownBehevior/>
                </hc:Interaction.Behaviors>
            </TextBox>
        </Grid>
        <Grid Grid.Row="1">
            <!-- DataGrid bound to an ItemsSource dependency property -->
            <DataGrid AutoGenerateColumns="False"
                     x:Name="dgvPoints"
                     hc:DataGridAttach.CanUnselectAllWithBlankArea="True"                                      
                     MinHeight="80"
                     SelectionMode="Single"
                     BorderThickness="0"
                     Background="{DynamicResource RegionBrush}"
                     Style="{DynamicResource DataGrid.Small}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     CanUserReorderColumns="False"
                     CanUserSortColumns="False"
                     CanUserResizeRows="False"
                     HorizontalScrollBarVisibility="Auto"
                     CanUserAddRows="False"
                     HeadersVisibility="Column"                                      
                     Validation.ErrorTemplate="{x:Null}"
                     GridLinesVisibility="None">
                <DataGrid.Columns>
                    
                    <!-- City column -->
                    <DataGridTemplateColumn Width="*" Header="City" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <hc:HighlightTextBlock FontWeight="SemiBold"  SourceText="{Binding POINT}" QueriesText="{Binding ElementName=TextBoxCity, Path=Text}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- State column -->
                    <DataGridTextColumn IsReadOnly="True" Width="Auto" MinWidth="50" Header="State" Binding="{Binding STATE, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"/>

                    <!-- Zip column -->
                    <DataGridTextColumn IsReadOnly="True" Width="Auto" MinWidth="60" Header="Zip" Binding="{Binding ZIP_CODE, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"/>
                             
                </DataGrid.Columns>
            </DataGrid>
            <!-- Fallback text if no data exists -->
            <TextBlock Margin="0 10 0 0" VerticalAlignment="Center"
               HorizontalAlignment="Center"
               FontWeight="SemiBold" 
               Visibility="{Binding ElementName=dgvPoints, Path=Items.Count, Converter={StaticResource Integer2VisibilityConverter}}">
        <Run Foreground="{DynamicResource PrimaryBrush}" FontFamily="{StaticResource FontAwesome}" Text="&#xf1c0;" />
        <Run BaselineAlignment="Center" Text="No data found" Foreground="{DynamicResource SecondaryTextBrush}" />
            </TextBlock>
        </Grid>
        <TextBlock Grid.Row="2" Text="[Enter - Search/Select] [Ctrl + D - Clear]" Foreground="{StaticResource PrimaryTextBrush}"/>
    </Grid>
</Window>
