<Window x:Class="DDCInteligence.View.AccountAliasSelectionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDCInteligence.View"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Alias Accounts" Height="450" Width="400">

    <Grid Margin="10 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" BorderThickness="0 0 0 1" Padding="0 0 0 10">
            <StackPanel Margin="20 0">
                <TextBlock Text="Account Selection" HorizontalAlignment="Center" FontSize="16"  FontWeight="Bold" Margin="0,10,0,5" />
                <TextBlock Foreground="#6B7280" Text="Choose an account to continue" HorizontalAlignment="Center" FontSize="12" TextWrapping="NoWrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <!-- DataGrid bound to an ItemsSource dependency property -->
            <ListBox x:Name="aliasSuggestionAccountList" HorizontalContentAlignment="Left" ScrollViewer.CanContentScroll="True" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                
                <!-- Suggestions will be dynamically added here -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Focusable="False" x:Name="SelectedList">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Description -->
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding NAME, UpdateSourceTrigger=PropertyChanged}"  Margin="10,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            
            <!-- Fallback text if no data exists -->
            <TextBlock Margin="0 10 0 0" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold"  Visibility="{Binding ElementName=aliasSuggestionAccountList, Path=Items.Count, Converter={StaticResource Integer2VisibilityConverter}}">
                <Run Foreground="{DynamicResource PrimaryBrush}" FontFamily="{StaticResource FontAwesome}" Text="&#xf1c0;" />
                <Run BaselineAlignment="Center" Text="No data found" Foreground="{DynamicResource SecondaryTextBrush}" />
            </TextBlock>
        </Grid>
        <TextBlock Margin="10" Grid.Row="2" Text="[Enter - Select] [ESC - Close]" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
    </Grid>
</Window>
