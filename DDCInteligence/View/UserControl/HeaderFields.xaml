<UserControl
    x:Class="DDCInteligence.View.UserControl.HeaderFields"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:DDCInteligence.Utilities.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="clr-namespace:DDCInteligence.Utilities.Helpers"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:loc="clr-namespace:DDCInteligence.Utilities.Services"
    xmlns:local="clr-namespace:DDCInteligence.View.UserControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    DataContext="{Binding Source={StaticResource Locator}, Path=BillingInfo}"
    mc:Ignorable="d">

    <!--  Add padding to the root if needed, avoiding negative margins inside  -->
    <StackPanel Margin="10,5" Orientation="Vertical">

        <!--  Top Row: Grid with Left and Right alignments  -->
        <Grid Margin="10,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <!--  Left Side (PRO)  -->
                <ColumnDefinition Width="*" />
                <!--  Spacer  -->
                <ColumnDefinition Width="Auto" />
                <!--  Right Side (Service & Excess)  -->
            </Grid.ColumnDefinitions>

            <!--  LEFT SIDE: PRO  -->
            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBox
                    x:Name="TextBoxPronumber"
                    Width="150"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Title="PRO"
                    hc:InfoElement.TitlePlacement="Left"
                    loc:TextBoxAttachServices.TextBoxController="{Binding ProNumberController}"
                    CharacterCasing="Upper"
                    FontWeight="Bold"
                    MaxLength="9"
                    Style="{StaticResource CustomTextBoxExtend}"
                    Text="{Binding Pronumber, UpdateSourceTrigger=PropertyChanged}"
                    Validation.ErrorTemplate="{x:Null}">
                    <hc:Interaction.Behaviors>
                        <behavior:FocusBehavior />
                        <behavior:PreviewKeydownBehevior />
                    </hc:Interaction.Behaviors>
                </TextBox>

                <ItemsControl Focusable="False" ItemsSource="{Binding ElementName=TextBoxPronumber, Path=(Validation.Errors)}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=TextBoxPronumber}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="Red"
                                Text="{Binding ErrorContent}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--  RIGHT SIDE: Service Level & Excess Coverage  -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <!--  Service Level  -->
                <TextBox
                    x:Name="TextBoxServiceType"
                    Width="180"
                    Margin="0,0,10,0"
                    hc:InfoElement.Title="Service Level"
                    hc:InfoElement.TitlePlacement="Left"
                    CharacterCasing="Upper"
                    FontWeight="Bold"
                    Style="{StaticResource CustomTextBoxExtend}"
                    Text="{Binding ServiceLevel, UpdateSourceTrigger=PropertyChanged}">
                    <hc:Interaction.Behaviors>
                        <behavior:FocusBehavior />
                        <behavior:PreviewKeydownBehevior />
                    </hc:Interaction.Behaviors>
                </TextBox>

                <!--  Excess coverage amount  -->
                <TextBox
                    x:Name="TextBoxExcessCoverageAmount"
                    MinWidth="250"
                    hc:InfoElement.Title="Excess coverage amount"
                    hc:InfoElement.TitlePlacement="Left"
                    CharacterCasing="Upper"
                    FontWeight="Bold"
                    Style="{StaticResource CustomTextBoxExtend}"
                    Text="{Binding ExcessCoverageAmount, UpdateSourceTrigger=PropertyChanged}">
                    <hc:Interaction.Behaviors>
                        <behavior:FocusBehavior />
                        <behavior:PreviewKeydownBehevior />
                    </hc:Interaction.Behaviors>
                </TextBox>
            </StackPanel>
        </Grid>

        <!--  BOTTOM ROW: Terms  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Content="Terms"
                FontWeight="Bold" />

            <Border
                Grid.Column="1"
                BorderBrush="{StaticResource SecondaryBorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
                <hc:ElementGroup HorizontalAlignment="Left" VerticalAlignment="Center">
                    <hc:FlexPanel FlexDirection="Row" JustifyContent="FlexStart">
                        <RadioButton
                            Margin="10,0,0,0"
                            Content="CALLER"
                            FontWeight="Bold"
                            GroupName="TermsGroup"
                            IsChecked="{Binding Terms, Converter={StaticResource TermsToRadioButtonConverter}, ConverterParameter=CALLER}" />
                        <RadioButton
                            Margin="10,0,0,0"
                            Content="SHIPPER"
                            FontWeight="Bold"
                            GroupName="TermsGroup"
                            IsChecked="{Binding Terms, Converter={StaticResource TermsToRadioButtonConverter}, ConverterParameter=SHIPPER}" />
                        <RadioButton
                            Margin="10,0,0,0"
                            Content="CONSIGNEE"
                            FontWeight="Bold"
                            GroupName="TermsGroup"
                            IsChecked="{Binding Terms, Converter={StaticResource TermsToRadioButtonConverter}, ConverterParameter=CONSIGNEE}" />
                        <RadioButton
                            Margin="10,0,0,0"
                            Content="OTHER"
                            FontWeight="Bold"
                            GroupName="TermsGroup"
                            IsChecked="{Binding Terms, Converter={StaticResource TermsToRadioButtonConverter}, ConverterParameter=OTHER}" />
                        <RadioButton
                            Margin="10,0,0,0"
                            Content="INTERLINER"
                            FontWeight="Bold"
                            GroupName="TermsGroup"
                            IsChecked="{Binding Terms, Converter={StaticResource TermsToRadioButtonConverter}, ConverterParameter=INTERLINER}" />
                        <RadioButton
                            Margin="10,0,0,0"
                            Content="OVERRIDE"
                            FontWeight="Bold"
                            GroupName="TermsGroup"
                            IsChecked="{Binding Terms, Converter={StaticResource TermsToRadioButtonConverter}, ConverterParameter=OVERRIDE}" />
                    </hc:FlexPanel>
                </hc:ElementGroup>
            </Border>
        </Grid>
    </StackPanel>

</UserControl>